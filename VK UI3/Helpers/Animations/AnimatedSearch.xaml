<?xml version="1.0" encoding="utf-8"?>
<Grid
    x:Class="VK_UI3.Helpers.Animations.AnimatedSearch"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:VK_UI3.Helpers.Animations"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ComboBox Grid.Row="1" x:Name="FilterBox" SelectedIndex="0" Margin="20,0,20,5" AutomationProperties.Name="Тип результатов поиска">
        <ComboBoxItem Content="Всё" Tag="all"/><ComboBoxItem Content="Треки" Tag="audios"/>
        <ComboBoxItem Content="Исполнители" Tag="artists"/><ComboBoxItem Content="Плейлисты" Tag="playlists"/>
    </ComboBox>
    <AutoSuggestBox TextChanged="SearchTextChanged" SuggestionChosen="SearchSuggestionChosen" Margin="20,5,20,5" PlaceholderText="Поиск музыки, плейлистов, исполнителей"
     
        
        x:Name="searchTXT"
        QueryIcon="Find"
        QuerySubmitted="AutoSuggestBox_QuerySubmitted"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Bottom"
        />
</Grid>
