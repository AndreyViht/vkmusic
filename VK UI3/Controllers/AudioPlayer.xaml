<?xml version="1.0" encoding="utf-8" ?>
<Page
	x:Class="VK_UI3.Controllers.AudioPlayer"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:constrols="using:VK_UI3.Controls"
	xmlns:controls="using:VK_UI3.Views.ModalsPages"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:helpers="using:VK_UI3.Helpers"
	xmlns:local1="using:VK_UI3.Converters"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	x:Name="pageRa"
	Clip="{x:Null}"
	IsEnabled="True"
	PointerEntered="Page_PointerEntered"
	PointerExited="Page_PointerExited"
	mc:Ignorable="d">

	<Page.Resources>
		<ThemeShadow x:Name="SharedShadow" />
		<local1:SecondsToTimeConverter x:Key="SecondsToTimeConverter" />
		<local1:LongToDoubleConverter x:Key="LongToDoubleConverter" />
		<Storyboard x:Key="SliderTrackMoveUp">
			<DoubleAnimation
				Storyboard.TargetName="sliderTrackGridUP"
				Storyboard.TargetProperty="(Canvas.Top)"
				To="-55"
				Duration="0:0:0.3" />
			<DoubleAnimation
				BeginTime="0:0:0.2"
				Storyboard.TargetName="sliderTrackGridUP"
				Storyboard.TargetProperty="Opacity"
				To="1"
				Duration="0:0:0.1" />
		</Storyboard>
		<Storyboard x:Key="SliderTrackMoveDown">
			<DoubleAnimation
				Storyboard.TargetName="sliderTrackGridUP"
				Storyboard.TargetProperty="(Canvas.Top)"
				To="0"
				Duration="0:0:0.3" />
			<DoubleAnimation
				BeginTime="0:0:0.0"
				Storyboard.TargetName="sliderTrackGridUP"
				Storyboard.TargetProperty="Opacity"
				To="0"
				Duration="0:0:0.1" />
		</Storyboard>
	</Page.Resources>

	<Grid
		x:Name="RootGrid"
        MinHeight="96"
        Background="{ThemeResource VihtPlayerBrush}"
		Padding="0"
		Clip="{x:Null}">
		<!--  FlyOutControl как скрытый элемент для доступа из кода  -->
		<Grid.ContextFlyout>
			<constrols:AudioControlFlyOut x:Name="FlyOutControl" />
		</Grid.ContextFlyout>

		<Grid
			HorizontalAlignment="Stretch"
			VerticalAlignment="Stretch"
			CornerRadius="20"
			Background="{ThemeResource VihtPlayerBrush}" />
		<Rectangle
			x:Name="RedRectangle"
			Width="0"
			Height="Auto"
			HorizontalAlignment="Left"
			IsHitTestVisible="False" Opacity="0.20"
			RadiusX="20"
            RadiusY="20">
            <Rectangle.Fill>
                <LinearGradientBrush x:Name="PlaybackGradient" StartPoint="0,0" EndPoint="1,1">
                    <GradientStop x:Name="ProgressStart" Color="#417DB1" Offset="0" />
                    <GradientStop x:Name="ProgressMiddle" Color="#6585AD" Offset="0.5" />
                    <GradientStop x:Name="ProgressEnd" Color="#407E87" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
		<!--  Основной контент  -->
		<Grid x:Name="PlayerContent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Padding="0,8">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="80" />
				<ColumnDefinition Width="2*" />
				<ColumnDefinition Width="3*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>



			<StackPanel x:Name="TransportPanel"
				Grid.Column="2"
				Padding="0,0,0,0"
				HorizontalAlignment="Stretch"
				VerticalAlignment="Center">
				<StackPanel
					Grid.Column="1"
					Margin="0,0,0,0"
					Padding="0"
					HorizontalAlignment="Center"
					VerticalAlignment="Stretch"
					CornerRadius="8"
					Orientation="Horizontal">

					<Button
						x:Name="repeatBTN"
						Grid.Column="4"
						Width="40"
						Height="40"
						Margin="0,0,12,0"
						Padding="0"
						CornerRadius="20"
						Background="Transparent"
						Tapped="repeatBTN_Tapped"
						AutomationProperties.Name="Повтор">
						<FontIcon
							x:Name="repeatBTNIcon"
							FontSize="16"
							Glyph="" />
					</Button>


					<Button
						x:Name="PreviousBTN"
						Grid.Column="0"
						Width="40"
						Height="40"
						Margin="0,0,0,0"
						Padding="0"
						CornerRadius="20"
						Background="Transparent"
						FocusVisualPrimaryBrush="Transparent"
						FocusVisualSecondaryThickness="0"
						Tapped="PreviousBTN_Tapped"
						AutomationProperties.Name="Предыдущий трек">
						<FontIcon FontSize="16" Glyph="" />
					</Button>

					<Button
						Width="56"
						Height="56"
						Margin="12,0,12,0"
						Padding="0"
						CornerRadius="28"
						Style="{ThemeResource VihtAccentButtonStyle}"
						Tapped="Button_Play_Tapped"
						AutomationProperties.Name="Воспроизвести">
						<FontIcon
							x:Name="PlayBTN" Foreground="{ThemeResource VihtAccentTextBrush}"
							FontSize="22"
							Glyph="" />
					</Button>

					<Button
						x:Name="NextBTN"
						Width="40"
						Height="40"
						Margin="0,0,12,0"
						Padding="0"
						CornerRadius="20"
						Background="Transparent"
						Tapped="NextBTN_Tapped"
						AutomationProperties.Name="Следующий трек">
						<FontIcon FontSize="16" Glyph="" />
					</Button>




					<Button
						Grid.Column="4"
						Width="35"
						Height="35"
						Padding="0"
						Background="Transparent"
						AutomationProperties.Name="Громкость">
						<FontIcon FontSize="14" Glyph="&#xE995;" />
						<Button.Flyout>
							<Flyout>
								<Grid Height="27" Margin="-15">
									<Slider
										x:Name="SoundSlider"
										Grid.Column="2"
										Width="150"
										Margin="10,-1,10,0"
										VerticalAlignment="Top"
										Background="AliceBlue"
										Minimum="0"
										Orientation="Horizontal"
										PointerEntered="SoundSlider_PointerEntered"
										PointerExited="SoundSlider_PointerExited"
										StepFrequency="1"
										ValueChanged="SoundSlider_ValueChanged"
										Value="{x:Bind simpleAudioBind, Mode=TwoWay}" />
								</Grid>
							</Flyout>
						</Button.Flyout>
					</Button>

				</StackPanel>

				<!-- ПРOГРЕСС БАР -->
				<Grid Margin="16,4,16,0" HorizontalAlignment="Stretch" MaxWidth="500">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>
					<TextBlock x:Name="textBlock" Text="{x:Bind TrackPositionMs, Mode=OneWay, Converter={StaticResource SecondsToTimeConverter}}" VerticalAlignment="Center" FontSize="12" Opacity="0.9" Margin="0,0,12,0" />
					<Slider x:Name="VolumeSlider" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,0,0" StepFrequency="1" Maximum="{x:Bind TrackDurationMs, Mode=TwoWay, Converter={StaticResource LongToDoubleConverter}}" Value="{x:Bind SliderPositionMs, Mode=TwoWay, Converter={StaticResource LongToDoubleConverter}}" PointerEntered="VolumeSlider_PointerEntered" PointerExited="VolumeSlider_PointerExited" ValueChanged="VolumeSlider_ValueChanged">
						<Slider.Resources>
							<x:Double x:Key="SliderTrackThemeHeight">4</x:Double>
							<x:Double x:Key="SliderThumbThemeSize">14</x:Double>
						</Slider.Resources>
					</Slider>
					<TextBlock Grid.Column="2" Text="{x:Bind TrackDurationMs, Mode=OneWay, Converter={StaticResource SecondsToTimeConverter}}" VerticalAlignment="Center" FontSize="12" Opacity="0.9" Margin="12,0,0,0" />
				</Grid>

			</StackPanel>


			<Grid
				Grid.Column="0"
				Width="64"
				Height="64"
				Margin="12,6,12,6"
				Background="{ThemeResource VihtCardBrush}"
				CornerRadius="{ThemeResource VihtCardCornerRadius}"
				Tapped="Grid_Tapped"
				Translation="0,0,16"
				AutomationProperties.Name="Обложка трека">
				<FontIcon Glyph="&#xEC4F;" FontSize="24" Opacity="0.5" />
				<Image x:Name="ImageThumb" Stretch="UniformToFill" />
			</Grid>
			<Grid
				Grid.Column="1"
                MinWidth="0"
                MaxHeight="75"
				Margin="0,6,8,6"
				Tapped="Grid_Tapped">
				<Grid.RowDefinitions>
					<RowDefinition Height="*" />
					<RowDefinition Height="*" />
				</Grid.RowDefinitions>
				<StackPanel
					x:Name="TitleClipGrid"
					Grid.Row="0"
					VerticalAlignment="Bottom"
					Orientation="Vertical"
					SizeChanged="TitleClipGrid_SizeChanged"
					AutomationProperties.Name="{x:Bind TrackDataThis.audio.Title, Mode=OneWay}"
					AutomationProperties.IsRequiredForForm="True"
					AutomationProperties.ItemType="Трек">
					<TextBlock
						x:Name="TitleTextBlock" Foreground="{ThemeResource VihtPlayerTextBrush}"
						MinWidth="0"
						VerticalAlignment="Center"
						Loaded="TitleTextBlock_Loaded"
						Opacity="1"
						FontWeight="SemiBold"
						FontSize="16"
						TextTrimming="CharacterEllipsis"
						TextWrapping="NoWrap"
						AutomationProperties.Name="{x:Bind TrackDataThis.audio.Title, Mode=OneWay}">
						<TextBlock.RenderTransform>
							<TranslateTransform x:Name="TitleTranslate" />
						</TextBlock.RenderTransform>
					</TextBlock>
				</StackPanel>
				<StackPanel
					x:Name="ArtistClipGrid"
					Grid.Row="1"
					VerticalAlignment="Top"
					Orientation="Vertical"
					SizeChanged="ArtistClipGrid_SizeChanged"
					AutomationProperties.Name="{x:Bind TrackDataThis.audio.Artist, Mode=OneWay}"
					AutomationProperties.IsRequiredForForm="True"
					AutomationProperties.ItemType="Исполнитель">
					<TextBlock
						x:Name="ArtistTextBlock" Foreground="{ThemeResource VihtSecondaryTextBrush}"
						MinWidth="0"
						Loaded="ArtistTextBlock_Loaded"
						Opacity="0.9"
						FontSize="13"
						TextTrimming="CharacterEllipsis"
						TextWrapping="NoWrap"
						AutomationProperties.Name="{x:Bind TrackDataThis.audio.Artist, Mode=OneWay}">
						<TextBlock.RenderTransform>
							<TranslateTransform x:Name="ArtistTranslate" />
						</TextBlock.RenderTransform>
					</TextBlock>
				</StackPanel>
			</Grid>

			<StackPanel x:Name="PlayerActions" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
				<Button
					x:Name="openLirycBTN"
					Grid.Column="0"
					Width="30"
					Height="30"
					Margin="8,0,0,0"
					Padding="0"
					Background="Transparent"
					Tapped="openLirycBTN_Tapped"
					AutomationProperties.Name="Открыть текст песни">
					<TextBlock>T</TextBlock>
					<ToolTipService.ToolTip>
						<ToolTip Content="Открыть текст песни" />
					</ToolTipService.ToolTip>

				</Button>

				<Button
					x:Name="OpenEqalizer"
					Grid.Column="0"
					Width="30"
					Height="30"
					Margin="8,0,0,0"
					Padding="0"
					Background="Transparent"
					Tapped="OpenEqalizer_Tapped"
					AutomationProperties.Name="Эквалайзер">
					<FontIcon Glyph="&#xE9E9;" />
					<ToolTipService.ToolTip>
						<ToolTip Content="Эквалайзер" />
					</ToolTipService.ToolTip>
					<Button.Flyout>
						<Flyout>
							<Flyout.FlyoutPresenterStyle>
								<Style TargetType="FlyoutPresenter">
									<Setter Property="MaxWidth" Value="4000" />
									<!--  Максимальная ширина  -->
									<Setter Property="MaxHeight" Value="6000" />
									<!--  Максимальная высота  -->
									<Setter Property="CornerRadius" Value="8" />
									<!--  Опционально: можно также задать Padding, чтобы контент не прилипал к краям  -->
									<Setter Property="Padding" Value="0" />
								</Style>
							</Flyout.FlyoutPresenterStyle>
							<controls:EqualizerControlPage />
						</Flyout>
					</Button.Flyout>
				</Button>

				<Button
					Grid.Column="0"
					Width="30"
					Height="30"
					Margin="8,0,8,0"
					Padding="0"
					Background="Transparent"
					Tapped="goToPlayList_BTN"
					AutomationProperties.Name="Посмотреть текущий список воспроизведения">
					<SymbolIcon Symbol="List" />
					<ToolTipService.ToolTip>
						<ToolTip Content="Посмотреть текущий список воспроизведения" />
					</ToolTipService.ToolTip>
				</Button>

				<Button
					x:Name="TranslatetoStatus"
					Width="30"
					Height="30"
					Margin="0,0,8,0"
					Padding="-2,-2,0,0"
					Background="Transparent"
					Tapped="TranslatetoStatus_Tapped"
					AutomationProperties.Name="Транслировать в статус ВК">
					<FontIcon
						x:Name="StatusBTNIcon"
						FontSize="12"
						Glyph="" />
					<ToolTipService.ToolTip>
						<ToolTip Content="Транслировать в статус ВК" />
					</ToolTipService.ToolTip>
				</Button>
				<Button
					x:Name="trackDoingBTN"
					Grid.Column="4"
					Width="30"
					Height="30"
					Margin="0,0,0,0"
					Padding="0"
					Background="Transparent"
					Tapped="trackDoingBTN_Tapped"
					AutomationProperties.Name="Действия с треком">
					<FontIcon Glyph="&#xE712;" />
				</Button>
			</StackPanel>


		</Grid>



	</Grid>



</Page>
