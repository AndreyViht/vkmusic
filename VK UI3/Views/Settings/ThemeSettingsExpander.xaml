<?xml version="1.0" encoding="utf-8" ?>
<Expander
    x:Class="VK_UI3.Views.Settings.ThemeSettingsExpander"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:VK_UI3.Views.Settings"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:services="using:VK_UI3.Services"
    HorizontalAlignment="Stretch"
    Margin="5"
    HorizontalContentAlignment="Stretch"
    IsExpanded="True"
    mc:Ignorable="d">

    <Expander.Header>
        <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon
                VerticalAlignment="Center"
                FontSize="16"
                Glyph="&#xE790;" />
            <TextBlock
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                Text="Тема оформления" />
        </StackPanel>
    </Expander.Header>

    <Expander.Content>
        <StackPanel Spacing="16">
            <!-- Режим темы (Светлая / Тёмная / OLED / Системная) -->
            <StackPanel Spacing="6">
                <TextBlock
                    Text="Основной режим"
                    FontWeight="SemiBold"
                    FontSize="13"
                    Opacity="0.8" />

                <RadioButtons x:Name="ThemeModeRadioButtons" MaxColumns="4" SelectionChanged="ThemeModeRadioButtons_SelectionChanged">
                    <RadioButton x:Name="RadioDark" Content="🌙 Тёмная" Tag="Dark" />
                    <RadioButton x:Name="RadioLight" Content="☀️ Светлая" Tag="Light" />
                    <RadioButton x:Name="RadioOled" Content="🖤 OLED Чёрный" Tag="OledBlack" />
                    <RadioButton x:Name="RadioSystem" Content="💻 Системная" Tag="System" />
                </RadioButtons>
            </StackPanel>

            <!-- Выбор цветового акцента -->
            <StackPanel Spacing="8">
                <TextBlock
                    Text="Цветовой акцент"
                    FontWeight="SemiBold"
                    FontSize="13"
                    Opacity="0.8" />

                <GridView
                    x:Name="AccentGridView"
                    SelectionMode="Single"
                    IsItemClickEnabled="True"
                    ItemClick="AccentGridView_ItemClick"
                    HorizontalAlignment="Stretch">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="services:AccentColorItem">
                            <StackPanel
                                Width="120"
                                Height="85"
                                Padding="8"
                                Margin="4"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Spacing="6"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                                <Ellipse
                                    Width="30"
                                    Height="30"
                                    HorizontalAlignment="Center">
                                    <Ellipse.Fill>
                                        <SolidColorBrush Color="{x:Bind Color}" />
                                    </Ellipse.Fill>
                                </Ellipse>
                                <TextBlock
                                    Text="{x:Bind Title}"
                                    FontSize="11"
                                    FontWeight="Medium"
                                    HorizontalAlignment="Center"
                                    TextAlignment="Center"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </StackPanel>
        </StackPanel>
    </Expander.Content>
</Expander>
