<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="VK_UI3.Controls.RecommsPlaylist"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:custom="using:VK_UI3.Helpers.Animations"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:VK_UI3.Controls"
    xmlns:customFlyout="using:VK_UI3.Views.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="194"
    Height="252"
    Margin="4,0,8,0"
    CornerRadius="16"
    PointerEntered="UserControl_PointerEntered"
    PointerExited="UserControl_PointerExited"
    PointerPressed="UserControl_PointerPressed"
    PointerReleased="UserControl_PointerReleased"
    PointerCanceled="UserControl_PointerCanceled"
    Translation="0,0,8"
    mc:Ignorable="d">

    <UserControl.Shadow>
        <ThemeShadow />
    </UserControl.Shadow>

    <UserControl.ContextFlyout>
        <customFlyout:CustomFlyout x:Name="flyOutm">
            <MenuFlyoutItem
                x:Name="AddRemove"
                Click="AddRemove_Click"
                Icon="Add"
                Text="Добавить к себе" />
            <MenuFlyoutItem
                x:Name="editAlbum"
                Click="editAlbum_Click"
                Icon="Edit"
                Text="Редактировать" />
            <MenuFlyoutItem
                x:Name="DeleteAlbum"
                Click="DeleteAlbum_Click"
                Icon="Delete"
                Text="Удалить" />
        </customFlyout:CustomFlyout>
    </UserControl.ContextFlyout>

    <Grid x:Name="CardBackgroundGrid" CornerRadius="{ThemeResource VihtCardCornerRadius}" Background="{ThemeResource VihtCardBrush}">
        <Grid.Resources>
            <!-- Анимация прозрачности кнопки Play -->
            <Storyboard x:Name="FadeInAnimationGridPlayIcon">
                <DoubleAnimation
                    Storyboard.TargetName="btnGrid"
                    Storyboard.TargetProperty="Opacity"
                    To="1"
                    Duration="0:0:0.2" />
            </Storyboard>
            <Storyboard x:Name="FadeOutAnimationGridPlayIcon">
                <DoubleAnimation
                    Storyboard.TargetName="btnGrid"
                    Storyboard.TargetProperty="Opacity"
                    To="0"
                    Duration="0:0:0.2" />
            </Storyboard>

            <!-- Анимация появления обложки -->
            <Storyboard x:Name="FadeInAnimationGrid">
                <DoubleAnimation
                    Storyboard.TargetName="fadeOp"
                    Storyboard.TargetProperty="Opacity"
                    To="1"
                    Duration="0:0:0.25" />
            </Storyboard>
            <Storyboard x:Name="FadeOutAnimationGrid">
                <DoubleAnimation
                    Storyboard.TargetName="fadeOp"
                    Storyboard.TargetProperty="Opacity"
                    To="0"
                    Duration="0:0:0.2" />
            </Storyboard>
        </Grid.Resources>

        <!-- Подложка с обложками -->
        <Grid x:Name="fadeOp" Opacity="0" CornerRadius="16">
            <custom:GridImagesCustom x:Name="GridThumbs" CornerRadius="16" Stretch="UniformToFill" AutomationProperties.Name="Изображения плейлиста">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
            </custom:GridImagesCustom>
        </Grid>

        <!-- Вертикальная текстура световых лучей/волн (как в официальном VK) -->
        <Border CornerRadius="16" IsHitTestVisible="False" Opacity="0.16">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#00FFFFFF" Offset="0.0"/>
                    <GradientStop Color="#35FFFFFF" Offset="0.09"/>
                    <GradientStop Color="#05FFFFFF" Offset="0.18"/>
                    <GradientStop Color="#50FFFFFF" Offset="0.27"/>
                    <GradientStop Color="#10FFFFFF" Offset="0.36"/>
                    <GradientStop Color="#55FFFFFF" Offset="0.45"/>
                    <GradientStop Color="#05FFFFFF" Offset="0.55"/>
                    <GradientStop Color="#45FFFFFF" Offset="0.65"/>
                    <GradientStop Color="#10FFFFFF" Offset="0.75"/>
                    <GradientStop Color="#50FFFFFF" Offset="0.84"/>
                    <GradientStop Color="#00FFFFFF" Offset="0.94"/>
                    <GradientStop Color="#25FFFFFF" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- Мягкое затемнение для читаемости текста -->
        <Border CornerRadius="16" IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Color="#35000000" Offset="0.0" />
                    <GradientStop Color="#00000000" Offset="0.4" />
                    <GradientStop Color="#50000000" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- Контент карточки -->
        <Grid Padding="16,16,16,16">
            <!-- Верхняя часть: Название и описание -->
            <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Top" Spacing="4">
                <TextBlock
                    x:Name="Title"
                    FontSize="22"
                    FontWeight="Bold"
                    Foreground="White"
                    TextWrapping="Wrap"
                    MaxLines="2"
                    TextTrimming="CharacterEllipsis"
                    AutomationProperties.Name="Название плейлиста" />
                <TextBlock
                    x:Name="Subtitle"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="#EEFFFFFF"
                    TextWrapping="Wrap"
                    MaxLines="3"
                    TextTrimming="CharacterEllipsis"
                    AutomationProperties.Name="Описание плейлиста" />
            </StackPanel>

            <!-- Кнопка воспроизведения (появляется при наведении) -->
            <Grid
                x:Name="btnGrid"
                Width="46"
                Height="46"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Background="{ThemeResource VihtSurfaceBrush}"
                CornerRadius="23"
                Opacity="0">
                <Button
                    Width="46"
                    Height="46"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Click="Button_Click"
                    CornerRadius="23"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0">
                    <FontIcon
                        x:Name="PlayPause"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="18"
                        Glyph="&#xF5B0;"
                        AutomationProperties.Name="Кнопка воспроизведения" />
                </Button>
            </Grid>
        </Grid>

        <!-- Тонкая рамка при наведении -->
        <Border
            x:Name="HoverBorder"
            BorderThickness="1"
            BorderBrush="{ThemeResource VihtStrokeBrush}"
            CornerRadius="16"
            IsHitTestVisible="False"
            Opacity="0.4" />
    </Grid>
</UserControl>
