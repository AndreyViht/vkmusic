<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="VK_UI3.Controls.RecommsPlaylist"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:custom="using:VK_UI3.Helpers.Animations"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:VK_UI3.Controls"
    xmlns:customFlyout="using:VK_UI3.Views.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="194"
    Height="252"
    Margin="4,0,8,0"
    CornerRadius="16"
    PointerEntered="UserControl_PointerEntered"
    PointerExited="UserControl_PointerExited"
    PointerPressed="UserControl_PointerPressed"
    PointerReleased="UserControl_PointerReleased"
    PointerCanceled="UserControl_PointerCanceled"
    Translation="0,0,8"
    mc:Ignorable="d">

    <UserControl.Shadow>
        <ThemeShadow />
    </UserControl.Shadow>

    <UserControl.ContextFlyout>
        <customFlyout:CustomFlyout x:Name="flyOutm">
            <MenuFlyoutItem
                x:Name="AddRemove"
                Click="AddRemove_Click"
                Icon="Add"
                Text="Добавить к себе" />
            <MenuFlyoutItem
                x:Name="editAlbum"
                Click="editAlbum_Click"
                Icon="Edit"
                Text="Редактировать" />
            <MenuFlyoutItem
                x:Name="DeleteAlbum"
                Click="DeleteAlbum_Click"
                Icon="Delete"
                Text="Удалить" />
        </customFlyout:CustomFlyout>
    </UserControl.ContextFlyout>

    <Grid x:Name="CardBackgroundGrid" CornerRadius="16" Background="{ThemeResource LayerOnAccentAcrylicFillColorDefaultBrush}">
        <Grid.Resources>
            <!-- Анимация прозрачности кнопки Play -->
            <Storyboard x:Name="FadeInAnimationGridPlayIcon">
                <DoubleAnimation
                    Storyboard.TargetName="btnGrid"
                    Storyboard.TargetProperty="Opacity"
                    To="1"
                    Duration="0:0:0.2" />
            </Storyboard>
            <Storyboard x:Name="FadeOutAnimationGridPlayIcon">
                <DoubleAnimation
                    Storyboard.TargetName="btnGrid"
                    Storyboard.TargetProperty="Opacity"
                    To="0"
                    Duration="0:0:0.2" />
            </Storyboard>

            <!-- Анимация появления обложки -->
            <Storyboard x:Name="FadeInAnimationGrid">
                <DoubleAnimation
                    Storyboard.TargetName="fadeOp"
                    Storyboard.TargetProperty="Opacity"
                    To="1"
                    Duration="0:0:0.25" />
            </Storyboard>
            <Storyboard x:Name="FadeOutAnimationGrid">
                <DoubleAnimation
                    Storyboard.TargetName="fadeOp"
                    Storyboard.TargetProperty="Opacity"
                    To="0"
                    Duration="0:0:0.2" />
            </Storyboard>
        </Grid.Resources>

        <!-- Подложка с обложками -->
        <Grid x:Name="fadeOp" Opacity="0" CornerRadius="16">
            <custom:GridImagesCustom x:Name="GridThumbs" CornerRadius="16" AutomationProperties.Name="Изображения плейлиста">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
            </custom:GridImagesCustom>
        </Grid>

        <!-- Градиентное затемнение для читаемости текста -->
        <Border CornerRadius="16">
            <Border.Background>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Color="#55000000" Offset="0.0" />
                    <GradientStop Color="#00000000" Offset="0.45" />
                    <GradientStop Color="#90000000" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- Контент карточки -->
        <Grid Padding="14">
            <!-- Верхняя часть: Название и описание -->
            <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Top" Spacing="4">
                <TextBlock
                    x:Name="Title"
                    FontSize="20"
                    FontWeight="Bold"
                    Foreground="White"
                    TextWrapping="Wrap"
                    MaxLines="2"
                    TextTrimming="CharacterEllipsis"
                    AutomationProperties.Name="Название плейлиста" />
                <TextBlock
                    x:Name="Subtitle"
                    FontSize="12"
                    FontWeight="Normal"
                    Foreground="#E0FFFFFF"
                    TextWrapping="Wrap"
                    MaxLines="3"
                    TextTrimming="CharacterEllipsis"
                    AutomationProperties.Name="Описание плейлиста" />
            </StackPanel>

            <!-- Нижняя часть: Иконка типа и кнопка воспроизведения -->
            <FontIcon
                Glyph="&#xE93C;"
                FontSize="16"
                Foreground="#B0FFFFFF"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                AutomationProperties.Name="Иконка плейлиста" />

            <Grid
                x:Name="btnGrid"
                Width="46"
                Height="46"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                CornerRadius="23"
                Opacity="0">
                <Button
                    Width="46"
                    Height="46"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Click="Button_Click"
                    CornerRadius="23"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0">
                    <FontIcon
                        x:Name="PlayPause"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="18"
                        Glyph="&#xF5B0;"
                        AutomationProperties.Name="Кнопка воспроизведения" />
                </Button>
            </Grid>
        </Grid>

        <!-- Тонкая рамка при наведении -->
        <Border
            x:Name="HoverBorder"
            BorderThickness="1"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            CornerRadius="16"
            IsHitTestVisible="False"
            Opacity="0.4" />
    </Grid>
</UserControl>
